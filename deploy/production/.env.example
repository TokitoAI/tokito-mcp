# Released server image. Use a vX.Y.Z tag; record its resolved digest before deploy.
TOKITO_MCP_IMAGE=ghcr.io/tokitoai/tokito-mcp:v0.1.8
TOKITO_MCP_ALLOWED_HOSTS=mcp.tokito.dev

# Pin the operator-approved cloudflared build by both version and digest.
CLOUDFLARED_IMAGE=cloudflare/cloudflared:<version>@sha256:<digest>

# Secret issued by Cloudflare Zero Trust for the mcp.tokito.dev tunnel.
CLOUDFLARE_TUNNEL_TOKEN=<secret>

# Optional server tuning.
TOKITO_MCP_MAX_SESSIONS=256
RUST_LOG=tokito_mcp_server=info,tower_http=info

# Required only with compose.generated.yml. This directory must be the same
# persistent directory used by Tokito Cloud ingestion.
TOKITO_GENERATED_DATA_DIR=/opt/tokito-generated
